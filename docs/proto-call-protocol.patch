+/// PROTOTYPE (docs/DESIGN_CALL_PROTOCOL.md, measurement only, UNSOUND where noted): `RN_PROTO=<bits>`, read once; 0 = off.
+pub fn proto_bits() -> u32 {
+    static V: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *V.get_or_init(|| {
+        std::env::var("RN_PROTO")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(0)
+    })
+}
