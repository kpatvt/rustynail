+/// BUNDLE-A item 2: the tier-1 stores into nil-valued nodes and empty array slots of tables with a metatable (limit `nilset`, struct default
+/// 0): programs `ba_nilset` and `r2_nilstore` against the interpreter run, in every trace mode, with exit storms, budgets, GC stress and the
+/// stack-move stress, with the knob on and (for the control) off. Mutants `nilset_flags_skip`, `nilset_mt_skip`, `nilset_barrier_skip`,
+/// `nilset_arr_mt_skip`.
+#[test]
+fn ba_nilset_programs() {
+    let mut jobs = Vec::new();
+    for p in ["ba_nilset", "r2_nilstore"] {
+        for trace in ["always", "on2", "on"] {
+            for (opts, budget) in [("", 0), ("+verify", 0), ("+exitstorm=3 +verify", 0), ("", 3), ("", 17), ("-loop", 0)] {
+                let mut j = Job::new(p, trace).opts(opts);
+                if budget != 0 {
+                    j = j.budget(budget);
+                }
+                jobs.push(j);
+            }
+            for gc in ["1", "2"] {
+                jobs.push(Job::new(p, trace).env("RUSTYNAIL_GC_STRESS", gc));
+            }
+            jobs.push(Job::new(p, trace).env("RUSTYNAIL_JIT_STRESS", "stackmove"));
+        }
+    }
+    for j in jobs.iter_mut() {
+        j.limits = "nilset=1".into();
+    }
+    for p in ["ba_nilset", "r2_nilstore"] {
+        let mut off = Job::new(p, "always").opts("+verify");
+        off.limits = "nilset=0".into();
+        jobs.push(off);
+    }
+    let res = compare(jobs);
+    assert!(!res.is_empty());
+}
