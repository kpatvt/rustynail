+
+/// Experiment C: equal-length byte compare without a `memcmp` call for short strings (no wide loads over bytes just stored one at a time).
+#[inline(always)]
+fn short_eq(a: &[u8], b: &[u8]) -> bool {
+    if a.len() <= 16 {
+        let mut d = 0u8;
+        for i in 0..a.len() {
+            d |= a[i] ^ b[i];
+        }
+        d == 0
+    } else {
+        a == b
+    }
+}
